# URL where the Spring Boot backend is reachable from the Node runtime.
# Server-side only — never NEXT_PUBLIC_. Used as the fallback for any path
# not matched by a per-module var below.
BACKEND_URL=http://localhost:8080/api

# Per-module backend bases (server-side only). When set, serverFetch routes by
# URL path prefix to the owning microservice; otherwise it falls back to
# BACKEND_URL. Each value includes the /api context path.
#   /auth, /users          -> USER_API_URL
#   /reports, /tasks        -> REPORT_API_URL
#   /notifications          -> NOTIFICATION_API_URL
#   /verifications          -> VERIFICATION_API_URL
# USER_API_URL=http://localhost:8080/api
# REPORT_API_URL=http://localhost:8081/api
# NOTIFICATION_API_URL=http://localhost:8082/api
# VERIFICATION_API_URL=http://localhost:8083/api

# httpOnly cookie security flag. Set to "true" in prod (HTTPS), "false" in local dev.
AUTH_COOKIE_SECURE=false

# Internal URL the Next.js server uses to call its own route handlers from server actions.
# Defaults to http://localhost:3000 (works inside a single pod/container).
# AUTH_INTERNAL_URL=
